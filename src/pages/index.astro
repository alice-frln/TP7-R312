---
import "leaflet/dist/leaflet.css";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <h1 class="text-2xl">Liste des établissements</h1>
  <div id="map" style="height: 600px;"></div>

  <script>
    import listeEtablissements from "../assets/ListeEtablissement.json";
    import L from "leaflet";

    const map = L.map("map").setView([46.6033, 1.883], 6);

    L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
    }).addTo(map);

    listeEtablissements.forEach((etablissement) => {
      L.marker([etablissement.lat, etablissement.lon])
        .addTo(map)
        .bindPopup(etablissement.name);
    });
  </script>
</Layout>
